# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TARGET_NOTIFICATION_EMAIL: Recipient email address for leads.
TARGET_NOTIFICATION_EMAIL="ajaysaaa150@gmail.com"

# =========================================================================
# VERCEL LIVE EMAIL DELIVERY CONFIGURATION (Choose Option A or Option B)
# =========================================================================

# OPTION A: Free Gmail SMTP (Recommended)
# 1. In your Google account (ajaysaaa150@gmail.com), turn on 2-Step Verification
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App password named "Vercel Website"
# 4. Copy the 16-character password and set these in Vercel Project Settings > Environment Variables:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="ajaysaaa150@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"

# OPTION B: Web3Forms (Alternative free service, zero SMTP setup required)
# 1. Visit https://web3forms.com
# 2. Enter ajaysaaa150@gmail.com to get your free access key
# 3. Add to Vercel Environment Variables:
WEB3FORMS_ACCESS_KEY=""
